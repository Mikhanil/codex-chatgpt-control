{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-chatgpt-control/contracts/v1/capabilities.schema.json",
  "type": "object",
  "required": ["protocolVersion", "packageVersion", "sessionId", "commands", "transports", "streaming", "execution"],
  "additionalProperties": false,
  "properties": {
    "protocolVersion": { "const": "chatgpt.browser_control.backend_request.v1" },
    "packageVersion": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "transports": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["stdio", "http"] }
    },
    "streaming": {
      "type": "object",
      "required": ["modes", "tokenDeltas"],
      "additionalProperties": false,
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["ndjson", "sse"] }
        },
        "tokenDeltas": { "const": false }
      }
    },
    "execution": {
      "type": "object",
      "required": ["browserCommands", "correlation", "tabAffinity", "subagentRuntime"],
      "additionalProperties": false,
      "properties": {
        "browserCommands": { "const": "serialized_per_session" },
        "correlation": { "const": "requestId" },
        "tabAffinity": { "const": "enforced_after_bootstrap" },
        "subagentRuntime": { "const": "bootstrap_per_agent" }
      }
    }
  }
}
